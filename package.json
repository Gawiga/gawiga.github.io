{
  "name": "gawigatemplate",
  "version": "1.0.0",
  "description": "My jekyll blog template.",
  "scripts": {
    "assets:build": "gulp build",
    "dev": "npm run assets:build && bundle exec jekyll serve --host localhost --port 4000",
    "build": "npm run build:site && npm test",
    "build:site": "npm run assets:build && bundle exec jekyll build",
    "serve": "npm run build:site && bundle exec jekyll serve",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build",
    "audit": "npm audit --omit=dev",
    "lighthouse": "node lighthouse-runner.mjs",
    "lighthouse:desktop": "LIGHTHOUSE_PRESET=desktop npm run lighthouse"
  },
  "keywords": [
    "frontend",
    "blog",
    "css",
    "stylus",
    "jekyll",
    "js"
  ],
  "author": "Gabriel William Galdino",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-terser": "^2.1.0",
    "jeet": "^7.2.0",
    "lighthouse": "^13.5.0",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "rupture": "^0.7.1",
    "stylus": "^0.64.0"
  }
}
