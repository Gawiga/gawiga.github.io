{
  "name": "gawigatemplate",
  "version": "1.0.0",
  "description": "My jekyll blog template.",
  "scripts": {
    "assets:build": "gulp build",
    "dev": "npm run assets:build && bundle exec jekyll serve --host 127.0.0.1 --port 4000",
    "build": "npm run build:site && npm test",
    "build:site": "npm run assets:build && bundle exec jekyll build",
    "serve": "npm run build:site && bundle exec jekyll serve",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build",
    "audit": "npm audit --omit=dev",
    "lighthouse": "lhci autorun --config=lighthouserc.js",
    "lighthouse:desktop": "LIGHTHOUSE_PRESET=desktop lhci autorun --config=lighthouserc.js"
  },
  "keywords": [
    "frontend",
    "blog",
    "css",
    "stylus",
    "jekyll",
    "js"
  ],
  "author": "Gabriel William Galdino",
  "license": "ISC",
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "autoprefixer-stylus": "^1.0.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-stylus": "^3.0.1",
    "gulp-terser": "^2.1.0",
    "jeet": "^7.2.0",
    "kouto-swiss": "^1.1.0",
    "rupture": "^0.7.1"
  }
}
